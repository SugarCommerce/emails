{
  "name": "sugarcommerce/emails",
  "description": "Emails a plugin sends and a site owner can change: merge tags, HTML that survives Outlook, named transactional emails with saved wording, a switch, a look and a settings screen with Preview and Send a test, sent through wp_mail() or any API you give it.",
  "homepage": "https://github.com/sugarcommerce/emails/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "email",
    "merge-tags",
    "html-email",
    "transactional-email",
    "email-templates",
    "wp-mail",
    "postmark",
    "resend"
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../text",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/plugin": "dev-main",
    "sugarcommerce/text": "dev-main"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "sugarcommerce/money": "Writes out the amounts of the order_items component in the order's currency."
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Emails\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Emails\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/sugarcommerce/emails/issues",
    "source": "https://github.com/sugarcommerce/emails"
  }
}
